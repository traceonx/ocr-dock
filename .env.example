WEB_PORT=8083
WEB_BIND=0.0.0.0
PUID=1000
PGID=1000
# Leave empty to generate and persist ./data/api_key at first startup.
# Set at least 16 characters to supply your own key. Never commit a real key.
API_KEY=
MAX_IMAGE_BYTES=2097152
MAX_PIXELS=4000000
MAX_CONCURRENCY=1
MAX_QUEUE=4
QUEUE_WAIT_SECONDS=10
RATE_LIMIT_PER_MINUTE=60
ORT_THREADS=2
# Optional, comma-separated exact browser origins; GM requests/server clients do not need CORS.
CORS_ORIGINS=
